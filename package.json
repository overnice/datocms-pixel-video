{
  "name": "@overnice/datocms-pixel-video",
  "version": "0.2.0",
  "description": "Video or image posterised into four pixel-mosaic layers with an organic pointer lens (WebGL2). A <pixel-video> custom element plus a React wrapper.",
  "license": "UNLICENSED",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/overnice/datocms-pixel-video.git"
  },
  "type": "module",
  "sideEffects": [
    "./dist/register.js",
    "./dist/react.js",
    "./dist/pixel-video.global.js"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./pixel-video.global.js": "./dist/pixel-video.global.js"
  },
  "scripts": {
    "dev": "vite demo",
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "tsup"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.9.10",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
